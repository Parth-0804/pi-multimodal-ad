new file mode 100644
index 0000000..739d8d3
--- /dev/null
+++ b/figures/review_explanatory_20261126/sensor_patch_tokens.tex
@@ -0,0 +1,64 @@
+% Compile from the thesis root with XeLaTeX. Synthetic schematic; no dataset payloads.
+\documentclass[12pt,border=0pt]{standalone}
+\usepackage{fontspec,amsmath,amssymb,fix-cm}
+\input{figures/tikz_style.tex}
+\usetikzlibrary{arrows.meta}
+\begin{document}
+\begin{tikzpicture}[x=1mm,y=1mm]
+  % Exact full-width canvas. The trace below is an illustrative analytic curve.
+  \path[use as bounding box] (0,0) rectangle (159.20,90);
+  \node[thesis panel label] at (79.6,85)
+    {Same channel, overlapping windows};
+
+  \node[module,minimum width=27mm,minimum height=9mm] (tokenone) at (34,72)
+    {Token 1};
+  \node[module,minimum width=27mm,minimum height=9mm] (tokentwo) at (119,72)
+    {Token 2};
+  \node[thesis annotation,align=center] at (78,72)
+    {Patch\ embedding};
+
+  % Progress position x maps to 16 + 2.65*(x-1) millimetres.
+  % Therefore positions 1,17,32,48 are at x=16,58.4,98.15,140.55.
+  \fill[ThesisHighlight!20!white] (58.4,25) rectangle (98.15,40);
+  \draw[draw=ThesisHighlight,line width=.8bp,dashed]
+    (58.4,25) -- (58.4,40) (98.15,25) -- (98.15,40);
+
+  % Two brackets over ONE sensor trace; each points to its own embedded token.
+  \draw[draw=ThesisBaseline,line width=.8bp]
+    (16,44.5) -- (16,47) -- (98.15,47) -- (98.15,44.5);
+  \node[thesis label] at (57.075,42.7) {Patch 1: positions 1--32};
+  \draw[arrow] (34,47) -- (tokenone.south);
+
+  \draw[draw=ThesisBaseline,line width=.8bp]
+    (58.4,56.5) -- (58.4,59) -- (140.55,59) -- (140.55,56.5);
+  \node[thesis label] at (99.475,54.8) {Patch 2: positions 17--48};
+  \draw[arrow] (119,59) -- (tokentwo.south);
+
+  % One synthetic sequence, sampled at the 48 illustrated progress positions.
+  \draw[draw=ThesisSensor,line width=1.4bp,line join=round]
+    plot[domain=1:48,samples=48]
+      ({16+2.65*(\x-1)},
+       {31+3.0*sin(35*\x)+1.5*sin(109*\x)+0.7*cos(17*\x)});
+  \node[thesis annotation,text=ThesisSensor,anchor=west] at (16,38.2)
+    {Schematic sensor values};
+  \node[thesis annotation] at (78.275,22)
+    {Shared positions 17--32};
+
+  \draw[arrow] (13,17) -- (146,17);
+  \foreach \pos/\xx in {1/16,17/58.4,32/98.15,48/140.55} {
+    \draw[draw=ThesisInk,line width=.8bp] (\xx,17) -- (\xx,15.7);
+    \node[thesis annotation,anchor=north,inner sep=1bp] at (\xx,15.5) {\pos};
+  }
+
+  % Start-to-start displacement, not patch width or elapsed physical time.
+  \draw[draw=ThesisBaseline,line width=.8bp,densely dotted]
+    (16,13) -- (16,7.5) (58.4,13) -- (58.4,7.5);
+  \draw[<->,>=stealth,draw=ThesisInk,line width=.8bp]
+    (16,8) -- (58.4,8);
+  \node[thesis label,anchor=north,inner sep=1bp] at (37.2,6.7)
+    {Stride: 16 positions};
+  \node[thesis annotation,align=center] at (110,6.8)
+    {Action-progress position\\(detail: 1--48 of 512)};
+
+\end{tikzpicture}
+\end{document}
