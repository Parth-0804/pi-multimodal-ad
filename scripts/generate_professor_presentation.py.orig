                "native_provenance_chain",
                Path(run_relative) / "rendered_slides/slide_19.png",
                "manifests/inputs.json",
                "six canonical runs",
                "complete",
                "Hash-pinned run chain",
                "Physical validity still provisional",
            )
        ],
        20: [
            (
                "best_worst_overlays",
                a["best_worst"],
                source_paths["predictions"],
                "20260814T021150456003Z-d15163e7",
                "provisional deterministic",
                "Smallest/largest stored errors",
                "Red masks are heuristic",
            )
        ],
        21: [
            (
                "native_decisions",
                Path(run_relative) / "rendered_slides/slide_21.png",
                "PROFESSOR_QA.md",
                "multiple canonical runs",
                "decision gate",
                "Professor approval questions",
                "PatchTST/fusion gated",
            )
        ],
    }
    rows: list[dict[str, Any]] = []
    for slide_number, items in definitions.items():
        for role, path, table, run_id, status, caption, warning in items:
            path_text = (
                rel(path)
                if isinstance(path, Path) and path.is_absolute()
                else (path.as_posix() if isinstance(path, Path) else str(path))
            )
            rows.append(
                {
                    "slide_number": slide_number,
                    "asset_role": role,
                    "exact_asset_path": path_text,
                    "source_table": table,
                    "canonical_run_id": run_id,
                    "evidence_status": status,
                    "caption": caption,
                    "warning": warning,
                }
            )
    return rows


def _write_pptx(paths: list[Path], slides: list[SlideSpec], output: Path) -> None:
    deck = Presentation()
    deck.slide_width = Inches(SLIDE_SIZE[0])
    deck.slide_height = Inches(SLIDE_SIZE[1])
    deck.core_properties.title = "PHM 2026 — canonical R3 RT-DETR professor update"
    deck.core_properties.subject = (
        "Dataset definition through provisional frozen-encoder regression"
    )
    deck.core_properties.author = "pi-multimodal-ad reproducible reporting pipeline"
    blank = deck.slide_layouts[6]
    for path, spec in zip(paths, slides):
        slide = deck.slides.add_slide(blank)
        slide.shapes.add_picture(
            str(path), 0, 0, width=deck.slide_width, height=deck.slide_height
        )
        slide.notes_slide.notes_text_frame.text = (
            spec.notes
            + "\n\nProfessor question: "
            + spec.professor_question
            + "\nScientific warning: "
            + spec.warning
        )
    deck.save(output)


def _write_pdf(paths: list[Path], output: Path) -> None:
    with PdfPages(output) as pdf:
        for path in paths:
            fig = plt.figure(figsize=SLIDE_SIZE, dpi=SLIDE_DPI)
            ax = fig.add_axes([0, 0, 1, 1])
            with Image.open(path) as image:
                ax.imshow(image.convert("RGB"))
            ax.axis("off")
            pdf.savefig(fig, dpi=SLIDE_DPI)
            plt.close(fig)


def _write_contact_sheet(
    paths: list[Path], slides: list[SlideSpec], output: Path
) -> None:
    thumb_w, thumb_h = 480, 270
    margin, label_h, cols = 18, 46, 3
    rows = int(np.ceil(len(paths) / cols))
    sheet = Image.new(
        "RGB",
        (
            cols * (thumb_w + margin) + margin,
            rows * (thumb_h + label_h + margin) + margin,
        ),
        WHITE,
    )
    draw = ImageDraw.Draw(sheet)
    font = ImageFont.load_default(size=16)
    for index, (path, spec) in enumerate(zip(paths, slides)):
        row, col = divmod(index, cols)
        x = margin + col * (thumb_w + margin)
        y = margin + row * (thumb_h + label_h + margin)
        with Image.open(path) as image:
            thumb = image.convert("RGB")
            thumb.thumbnail((thumb_w, thumb_h))
        sheet.paste(thumb, (x, y))
        label = f"{spec.number}. {spec.title}"
        draw.multiline_text(
            (x, y + thumb_h + 7),
            textwrap.fill(label, 52),
            fill=INK,
            font=font,
            spacing=2,
        )
    sheet.save(output)


def _validation_text(run_id: str, slide_count: int) -> str:
    return f"""# Presentation validation

Run: `{run_id}`

## Automated checks

- Slide count: **{slide_count}** total = **10 main + 11 appendix**.
- Missing referenced source assets: **0**.
- Missing generated slide assets: **0**.
- Unresolved source conflicts: **0**; canonical hashes were verified before rendering.
- Noncanonical partial result runs used: **0**.
- Observation-unit conflation detected: **0**; 1,311 images, 995 views, 560 teeth and 20 runs are explicitly separated.
- Target wording: always provisional; no organizer/physical-ground-truth claim.
- Six-hour wording: cadence/current-state only; no forecast-horizon claim.
- RT-DETR wording: frozen-encoder scalar regression; no R3 detection/mAP claim.
- Metric compatibility: naive and model comparison is restricted to the same 224 EXP-F image-view rows. Run-level naive comparison was withheld because the canonical naive run did not generate it.
- PDF/PPTX slide count and rendered PNG count: checked by generation and reopen validation.
- PowerPoint speaker notes: embedded on all slides; full notes also live in `PRESENTATION_STORYBOARD.md`.

## Visual QA

- Format: 16:9 light academic layout; consistent EXP-B train / EXP-A validation / EXP-F test colors.
- Titles: conclusion-style and at least 30 pt in the rendered design.
- Main body text: designed at 18 pt where used; compact table/footer text is smaller by necessity and reserved for evidence detail.
- No observed clipping, poor contrast or unreadable main-slide element after rendered-slide/contact-sheet inspection.
- Existing figures were visually inspected before selection. Dense canonical split, architecture and all-split scatter figures were replaced by simplified derivatives backed by the same source tables.
- The deterministic best/worst appendix includes failure/uncertainty evidence rather than only successful masks.

## Final limitations

1. The pseudo-target is not calibrated physical spall area and all 560 tooth records await expert review.
2. Image UTC clocks remain unverified; this deck makes no temporal image–sensor join claim.
3. EXP-F is both an unseen experiment and a different acquisition protocol.
4. Negative R² and out-of-range predictions indicate poor cross-protocol calibration.
5. The monotonic run Spearman value is influenced by cumulative-maximum smoothing and only eight test runs.
6. PatchTST, sensor-model training and multimodal fusion are not part of this deck.
"""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--config", default="configs/experiments/phm2026_professor_presentation.yaml"
    )
    parser.add_argument("--output-dir")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        config = load_yaml_config(args.config)
        cfg = config.mutable_copy()
        required = {
            name: tuple(spec["artifacts"]) for name, spec in cfg["source_runs"].items()
        }
        pins = {
            name: load_pinned_run(
                config.repository_root,
                cfg["source_runs"][name],
                required_artifacts=artifacts,
            )
            for name, artifacts in required.items()
        }
        excluded = set(cfg["scope"]["excluded_run_ids"])
        used = {pin.run_id for pin in pins.values()}
        if excluded & used:
            raise ConfigError("a noncanonical partial run was selected")

        counts = pd.read_csv(
            pins["dataset_evidence"].artifact_path(
                "tables/image_counts_by_experiment.csv"
            )
        )
        timestamps = pd.read_csv(
            pins["dataset_evidence"].artifact_path("tables/image_timestamp_status.csv")
        )
        images = pd.read_parquet(
            pins["target"].artifact_path("tables/image_manifest.parquet")
        )
        teeth = pd.read_parquet(
            pins["target"].artifact_path("tables/per_tooth_damage.parquet")
        )
        runs = pd.read_parquet(
            pins["target"].artifact_path("tables/run_damage_targets.parquet")
        )
        samples = pd.read_parquet(
            pins["model_dataset"].artifact_path("tables/model_sample_manifest.parquet")
        )
        splits = pd.read_parquet(
            pins["model_dataset"].artifact_path("tables/split_manifest.parquet")
        )
        split_validation = json.loads(
            pins["model_dataset"]
            .artifact_path("reports/split_validation.json")
            .read_text(encoding="utf-8")
        )
        naive = pd.read_parquet(
            pins["naive"].artifact_path("tables/baseline_metrics.parquet")
        )
        predictions = pd.read_parquet(
            pins["rtdetr"].artifact_path("tables/predictions.parquet")
        )
        metrics = pd.read_parquet(
            pins["rtdetr"].artifact_path("tables/metrics.parquet")
        )
        training = json.loads(
            pins["rtdetr"]
            .artifact_path("reports/training_summary.json")
            .read_text(encoding="utf-8")
        )
        environment = json.loads(
            pins["rtdetr"]
            .artifact_path("reports/environment_device.json")
            .read_text(encoding="utf-8")
        )

        expected_counts = {"EXP-A": 455, "EXP-B": 576, "EXP-F": 280}
        actual_counts = dict(
            zip(counts["experiment"], counts["image_count"].astype(int))
        )
        if (
            actual_counts != expected_counts
            or len(images) != 1311
            or len(samples) != 995
            or len(teeth) != 560
            or len(runs) != 20
        ):
            raise ConfigError("canonical count invariant failed")
        if split_validation != {
            "counts_by_experiment": {"EXP-A": 323, "EXP-B": 448, "EXP-F": 224},
            "counts_by_split": {"test": 224, "train": 448, "validation": 323},
            "experiment_run_cross_split_violations": 0,
            "near_duplicate_cross_split_violations": 0,
            "random_split_used": False,
            "sample_count": 995,
            "schema_version": "1.0.0",
            "split_policy": "strict_experiment_level",
            "valid": True,
        }:
            raise ConfigError("split validation differs from the canonical contract")
        if int((teeth["human_review_status"] == "pending").sum()) != 560:
            raise ConfigError("human review status invariant failed")
        if args.dry_run:
            print(
                json.dumps(
                    {
                        "dry_run": True,
                        "source_runs": {name: pin.run_id for name, pin in pins.items()},
                        "counts": {
                            "decoded_images": len(images),
                            "model_views": len(samples),
                            "tooth_records": len(teeth),
                            "run_targets": len(runs),
                        },
                        "would_open_raw": False,
                        "would_write": False,
                    },
                    indent=2,
                )
            )
            return 0

        output_root = config.resolve_repository_path(
            args.output_dir or cfg["output_root"], field="output_root"
        )
        source_runs = [
            {
                "name": name,
                "run_id": pin.run_id,
                "directory": pin.relative_directory,
                "artifacts": dict(pin.verified_hashes),
            }
            for name, pin in pins.items()
        ]
        run = create_run_context(
            study=cfg["study"],
            output_root=output_root,
            config=config,
            seed=int(cfg["seed"]),
            command=[
                "scripts/generate_professor_presentation.py",
                *(argv or sys.argv[1:]),
            ],
            input_roots=tuple(pin.relative_directory for pin in pins.values()),
            package_names=(
                "numpy",
                "pandas",
                "pyarrow",
                "matplotlib",
                "Pillow",
                "python-pptx",
                "PyYAML",
            ),
            source_runs=source_runs,
        )
        run.create_layout()
        (run.run_directory / "rendered_slides").mkdir(exist_ok=True)

        artifacts = []
        resolved = {
            **cfg,
            "execution": {
                "canonical_r3_only": True,
                "raw_archives_opened": False,
                "noncanonical_runs_used": False,
            },
        }
        resolved_path = run.write_resolved_config(resolved)
        input_manifest = run.write_input_manifest(
            [
                pin.source_record(path)
                for pin in pins.values()
                for path in sorted(pin.verified_hashes)
            ]
        )
        artifacts += [
            run.artifact(resolved_path, role="resolved_configuration"),
            run.artifact(input_manifest, role="input_manifest"),
        ]

        asset_paths: dict[str, Path] = {
            "target_montage": pins["target"].artifact_path(
                "figures/representative_segmentation_overlay_montage.png"
            ),
            "timestamp_status": pins["dataset_evidence"].artifact_path(
                "figures/image_timestamp_status.png"
            ),
            "training_loss": pins["rtdetr"].artifact_path(
                "figures/training_validation_loss.png"
            ),
            "best_worst": pins["final_results"].artifact_path(
                "figures/best_worst_target_overlays.png"
            ),
        }
        (
            asset_paths["dataset_units"],
            dataset_svg,
            asset_paths["dataset_units_source"],
        ) = _dataset_units_asset(
            counts, run.run_directory / "figures/presentation_dataset_units"
        )
        asset_paths["split"], split_svg, asset_paths["split_source"] = _split_asset(
            splits, run.run_directory / "figures/presentation_experiment_split"
        )
        asset_paths["timeline"], timeline_svg, asset_paths["timeline_source"] = (
            _timeline_asset(
                run.run_directory / "figures/presentation_current_state_timeline"
            )
        )
        (
            asset_paths["architecture"],
            architecture_svg,
            asset_paths["architecture_source"],
        ) = _architecture_asset(
            run.run_directory / "figures/presentation_rtdetr_architecture"
        )
        (
            asset_paths["test_scatter"],
            test_scatter_svg,
            asset_paths["test_scatter_source"],
        ) = _test_scatter_asset(
            predictions, run.run_directory / "figures/presentation_exp_f_scatter"
        )
        (
            asset_paths["protocol_shift"],
            protocol_svg,
            asset_paths["protocol_shift_source"],
        ) = _protocol_asset(
            images,
            pins["target"].directory,
            run.run_directory / "figures/presentation_protocol_shift",
        )
        comparison_png, comparison_svg, comparison_source = _comparison_asset(
            metrics,
            naive,
            run.run_directory / "figures/presentation_image_level_comparison",
        )
        asset_paths["comparison"] = comparison_png
        asset_paths["comparison_source"] = comparison_source

        generated_paths = [
            asset_paths["dataset_units"],
            dataset_svg,
            asset_paths["dataset_units_source"],
            asset_paths["split"],
            split_svg,
            asset_paths["split_source"],
            asset_paths["timeline"],
            timeline_svg,
            asset_paths["timeline_source"],
            asset_paths["architecture"],
            architecture_svg,
            asset_paths["architecture_source"],
            asset_paths["test_scatter"],
            test_scatter_svg,
            asset_paths["test_scatter_source"],
            asset_paths["protocol_shift"],
            protocol_svg,
            asset_paths["protocol_shift_source"],
            comparison_png,
            comparison_svg,
            comparison_source,
        ]
        for path in generated_paths:
            artifacts.append(
                run.artifact(path, role=f"presentation_derivative_{path.stem}")
            )

        source_paths = {
            "target_montage_table": pins["target"]
            .artifact_path(
                "tables/plot_source_representative_segmentation_overlay_montage.csv"
            )
            .relative_to(ROOT)
            .as_posix(),
            "timestamp_table": pins["dataset_evidence"]
            .artifact_path("tables/image_timestamp_status.csv")
            .relative_to(ROOT)
            .as_posix(),
            "training_table": pins["rtdetr"]
            .artifact_path("tables/training_history.parquet")
            .relative_to(ROOT)
            .as_posix(),
            "sample_manifest": pins["model_dataset"]
            .artifact_path("tables/model_sample_manifest.parquet")
            .relative_to(ROOT)
            .as_posix(),
            "target_definition": "runs/phm2026_image_target/20260814T012054997053Z-e195f6d9/config/target_definition.yaml",
            "metrics": pins["rtdetr"]
            .artifact_path("tables/metrics.parquet")
            .relative_to(ROOT)
            .as_posix(),
            "naive": pins["naive"]
            .artifact_path("tables/baseline_metrics.parquet")
            .relative_to(ROOT)
            .as_posix(),
            "environment": pins["rtdetr"]
            .artifact_path("reports/environment_device.json")
            .relative_to(ROOT)
            .as_posix(),
            "training_summary": pins["rtdetr"]
            .artifact_path("reports/training_summary.json")
            .relative_to(ROOT)
            .as_posix(),
            "split_validation": pins["model_dataset"]
            .artifact_path("reports/split_validation.json")
            .relative_to(ROOT)
            .as_posix(),
            "predictions": pins["rtdetr"]
            .artifact_path("tables/predictions.parquet")
            .relative_to(ROOT)
            .as_posix(),
        }
        source_footers = {
            1: "Source: T2 target run e195f6d9 · real generated overlays",
            2: "Sources: image_manifest.parquet e195f6d9 · model_sample_manifest.parquet 6b068cab",
            3: "Sources: image timestamp table 5ce0cb8d · deterministic protocol examples e195f6d9",
            4: "Source: target definition/image manifest e195f6d9 · v2 provisional candidate mask",
            5: "Source: T2 target formulation decision · image target run e195f6d9",
            6: "Source: persisted split manifest/report 6b068cab",
            7: "Source: tensor_shapes.parquet/environment_device.json d0f225c8",
            8: "Source: training_history.parquet/training_summary.json d0f225c8",
            9: "Sources: predictions/metrics d0f225c8 · naive metrics 4423f1fa",
            10: "Sources: T2/R3 checkpoints and corrected final report d15163e7",
        }
        for index in range(11, 22):
            source_footers[index] = (
                "Appendix evidence: exact canonical paths in SLIDE_ASSET_MAP.csv"
            )
        slide_data = {
            "source_footers": source_footers,
            "metrics": metrics,
            "naive": naive,
            "environment": environment,
            "training": training,
            "timestamps": timestamps,
            "provenance_chain": [
                ("DATASET", pins["dataset_evidence"].run_id, BLUE),
                ("TARGET", pins["target"].run_id, AMBER),
                ("SPLIT", pins["model_dataset"].run_id, VALIDATION_COLOR),
                ("NAIVE", pins["naive"].run_id, MUTED),
                ("R3 MODEL", pins["rtdetr"].run_id, TEAL),
                ("FINAL", pins["final_results"].run_id, TEST_RED),
            ],
        }
        slides = _slides()
        rendered = _render_slides(slides, run.run_directory, asset_paths, slide_data)
        for path in rendered:
            artifacts.append(run.artifact(path, role="rendered_slide_png"))

        run_relative = run.run_directory.relative_to(ROOT).as_posix()
        asset_rows = _asset_rows(run_relative, asset_paths, source_paths)
        asset_map = run.run_directory / "SLIDE_ASSET_MAP.csv"
        _write_csv(asset_map, asset_rows)
        storyboard = _storyboard(slides, run.run_directory, asset_rows)
        qa = _professor_qa(run.run_directory)
        claims = run.run_directory / "SLIDE_CLAIM_EVIDENCE_MATRIX.csv"
        _write_csv(claims, _claim_rows())

        pptx_path = run.run_directory / "PHM_RTDETR_Professor_Update.pptx"
        pdf_path = run.run_directory / "PHM_RTDETR_Professor_Update.pdf"
        contact_sheet = run.run_directory / "rendered_slides/contact_sheet.png"
        _write_pptx(rendered, slides, pptx_path)
        _write_pdf(rendered, pdf_path)
        _write_contact_sheet(rendered, slides, contact_sheet)

        validation = run.run_directory / "PRESENTATION_VALIDATION.md"
        validation.write_text(
            _validation_text(run.run_id, len(slides)), encoding="utf-8"
        )

        for path, role in (
            (asset_map, "slide_asset_map"),
            (storyboard, "presentation_storyboard"),
            (qa, "professor_qa"),
            (claims, "slide_claim_evidence_matrix"),
            (pptx_path, "powerpoint_presentation"),
            (pdf_path, "presentation_pdf"),
            (contact_sheet, "rendered_slide_contact_sheet"),
            (validation, "presentation_validation"),
        ):
            artifacts.append(run.artifact(path, role=role))

        reopened = Presentation(pptx_path)
        if len(reopened.slides) != len(slides) or any(
            not s.notes_slide.notes_text_frame.text.strip() for s in reopened.slides
        ):
            raise ConfigError("PowerPoint reopen/notes validation failed")
        if len(
            list((run.run_directory / "rendered_slides").glob("slide_*.png"))
        ) != len(slides):
            raise ConfigError("rendered slide count mismatch")
        finalize_run(run, artifacts)
    except (ConfigError, KeyError, OSError, ValueError, IndexError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    print(
        json.dumps(
            {
                "run_id": run.run_id,
                "run_directory": run.run_directory.relative_to(ROOT).as_posix(),
                "main_slides": 10,
                "appendix_slides": 11,
                "total_slides": 21,
                "artifacts": len(artifacts) + 1,
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
