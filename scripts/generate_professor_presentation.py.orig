def _figure(title: str, subtitle: str = "") -> plt.Figure:
    fig = plt.figure(figsize=SLIDE_SIZE, dpi=SLIDE_DPI, facecolor=WHITE)
    wrapped_title = textwrap.fill(title, width=58)
    two_lines = "\n" in wrapped_title
    fig.text(
        0.055,
        0.965,
        wrapped_title,
        fontsize=28,
        fontweight="bold",
        color=NAVY,
        va="top",
        linespacing=0.98,
    )
    subtitle_y = 0.835 if two_lines else 0.875
    divider_y = 0.812 if two_lines else 0.845
    if subtitle:
        fig.text(0.056, subtitle_y, subtitle, fontsize=13, color=TEAL, va="top")
    line = plt.Line2D(
        [0.055, 0.945], [divider_y, divider_y], color=GRID, linewidth=1.2
    )
    fig.add_artist(line)
    return fig


def _footer(fig: plt.Figure, slide: SlideSpec, sources: str) -> None:
    fig.text(0.055, 0.022, sources, fontsize=7.5, color=MUTED, va="bottom")
    fig.text(
        0.945,
        0.022,
        f"{slide.section} · {slide.number}/21",
        fontsize=8,
        color=MUTED,
        ha="right",
        va="bottom",
    )


def _banner(fig: plt.Figure, text: str = PROVISIONAL_BANNER) -> None:
    fig.text(
        0.5,
        0.785,
        text,
        fontsize=10,
        fontweight="bold",
        color=TEST_RED,
        ha="center",
        va="center",
        bbox={
            "boxstyle": "round,pad=0.32",
            "facecolor": "#FBEDEE",
            "edgecolor": "#E7B8BC",
        },
    )


def _card(
    fig: plt.Figure,
    x: float,
    y: float,
    w: float,
    h: float,
    title: str,
    body: str,
    *,
    color: str = NAVY,
    face: str = LIGHT,
    title_size: float = 16,
    body_size: float = 13,
    align: str = "left",
) -> None:
    patch = FancyBboxPatch(
        (x, y),
        w,
        h,
        boxstyle="round,pad=0.012,rounding_size=0.012",
        transform=fig.transFigure,
        facecolor=face,
        edgecolor=color,
        linewidth=1.5,
    )
    fig.add_artist(patch)
    tx = x + (w / 2 if align == "center" else 0.018)
    ha = "center" if align == "center" else "left"
    fig.text(
        tx,
        y + h - 0.04,
        title,
        fontsize=title_size,
        fontweight="bold",
        color=color,
        ha=ha,
        va="top",
    )
    fig.text(
        tx,
        y + h - 0.092,
        body,
        fontsize=body_size,
        color=INK,
        ha=ha,
        va="top",
        linespacing=1.28,
    )


def _bullets(
    fig: plt.Figure,
    items: tuple[str, ...] | list[str],
    *,
    x: float,
    y: float,
    width: int = 52,
    size: float = 17,
    color: str = INK,
    line_gap: float = 0.092,
) -> None:
    current = y
    for item in items:
        wrapped = textwrap.fill(item, width=width, subsequent_indent="  ")
        fig.text(
            x,
            current,
            "• " + wrapped,
            fontsize=size,
            color=color,
            va="top",
            linespacing=1.25,
        )
        current -= line_gap * max(1, wrapped.count("\n") + 1)


def _add_image(
    fig: plt.Figure, path: Path, rect: tuple[float, float, float, float]
) -> None:
    ax = fig.add_axes(rect)
    with Image.open(path) as source:
        ax.imshow(source.convert("RGB"))
    ax.axis("off")


def _arrow(
    fig: plt.Figure,
    start: tuple[float, float],
    end: tuple[float, float],
    color: str = NAVY,
) -> None:
    fig.add_artist(
        FancyArrowPatch(
            start,
            end,
            transform=fig.transFigure,
            arrowstyle="-|>",
            mutation_scale=16,
            linewidth=1.8,
            color=color,
        )
    )


def _save_pair(fig: plt.Figure, stem: Path) -> tuple[Path, Path]:
    return save_figure_pair(fig, stem)


def _write_csv(path: Path, rows: list[dict[str, Any]]) -> None:
    columns = sorted({key for row in rows for key in row})
    with path.open("w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=columns)
        writer.writeheader()
        writer.writerows(rows)


def _dataset_units_asset(counts: pd.DataFrame, out: Path) -> tuple[Path, Path, Path]:
    rows = [
        {"unit": "decoded_images", "count": 1311, "scope": "all image stages"},
        {
            "unit": "post_run_model_views",
            "count": 995,
            "scope": "eligible post-run views",
        },
        {"unit": "tooth_run_records", "count": 560, "scope": "experiment/run/tooth"},
        {"unit": "run_targets", "count": 20, "scope": "one per run"},
    ]
    source = out.parent.parent / "tables/presentation_dataset_units.csv"
    _write_csv(source, rows)
    fig, axes = plt.subplots(
        1, 2, figsize=(12, 4.1), gridspec_kw={"width_ratios": [1.05, 1.3]}
    )
    ordered = counts.set_index("experiment").loc[["EXP-A", "EXP-B", "EXP-F"]]
    colors = [VALIDATION_COLOR, TRAIN_COLOR, TEST_COLOR]
    axes[0].bar(ordered.index, ordered["image_count"], color=colors, width=0.65)
    for idx, value in enumerate(ordered["image_count"]):
        axes[0].text(
            idx,
            value + 12,
            f"{int(value):,}",
            ha="center",
            fontsize=12,
            fontweight="bold",
        )
    axes[0].set(title="Decoded images", ylabel="Images")
    axes[0].set_ylim(0, 650)
    axes[0].grid(axis="y", color=GRID)
    axes[0].grid(axis="x", visible=False)
    labels = [
        "1,311 decoded\nall stages",
        "995 model views\npost-run",
        "560 tooth/run\nrecords",
        "20 run\ntargets",
    ]
    xs = [0.12, 0.38, 0.64, 0.88]
    widths = [0.22, 0.20, 0.18, 0.14]
    for i, (x, width, label) in enumerate(zip(xs, widths, labels)):
        axes[1].add_patch(
            FancyBboxPatch(
                (x - width / 2, 0.38),
                width,
                0.28,
                boxstyle="round,pad=0.012",
                transform=axes[1].transAxes,
                facecolor="#EAF1F6",
                edgecolor=NAVY,
                linewidth=1.5,
            )
        )
        axes[1].text(
            x,
            0.52,
            label,
            transform=axes[1].transAxes,
            ha="center",
            va="center",
            fontsize=11,
            fontweight="bold",
        )
        if i < 3:
            axes[1].annotate(
                "",
                xy=(xs[i + 1] - widths[i + 1] / 2, 0.52),
                xytext=(x + width / 2, 0.52),
                xycoords=axes[1].transAxes,
                arrowprops={"arrowstyle": "->", "color": NAVY, "lw": 1.7},
            )
    axes[1].text(
        0.5,
        0.79,
        "Different observation units—not attrition",
        transform=axes[1].transAxes,
        ha="center",
        fontsize=13,
        fontweight="bold",
        color=NAVY,
    )
    axes[1].axis("off")
    fig.tight_layout()
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _split_asset(split_manifest: pd.DataFrame, out: Path) -> tuple[Path, Path, Path]:
    rows = (
        split_manifest.groupby(["split", "experiment"], as_index=False)
        .size()
        .rename(columns={"size": "sample_count"})
        .to_dict("records")
    )
    source = out.parent.parent / "tables/presentation_split.csv"
    _write_csv(source, rows)
    fig, ax = plt.subplots(figsize=(11.2, 3.8))
    cards = [
        ("TRAIN", "EXP-B", 448, TRAIN_COLOR),
        ("VALIDATION", "EXP-A", 323, VALIDATION_COLOR),
        ("TEST", "EXP-F", 224, TEST_COLOR),
    ]
    for idx, (partition, experiment, count, color) in enumerate(cards):
        x = 0.06 + idx * 0.32
        ax.add_patch(
            FancyBboxPatch(
                (x, 0.25),
                0.25,
                0.52,
                boxstyle="round,pad=0.02",
                transform=ax.transAxes,
                facecolor=color,
                edgecolor=color,
            )
        )
        ax.text(
            x + 0.125,
            0.65,
            partition,
            transform=ax.transAxes,
            ha="center",
            va="center",
            color=WHITE,
            fontsize=13,
            fontweight="bold",
        )
        ax.text(
            x + 0.125,
            0.49,
            experiment,
            transform=ax.transAxes,
            ha="center",
            va="center",
            color=WHITE,
            fontsize=20,
            fontweight="bold",
        )
        ax.text(
            x + 0.125,
            0.34,
            f"{count} views",
            transform=ax.transAxes,
            ha="center",
            va="center",
            color=WHITE,
            fontsize=13,
        )
    ax.text(
        0.5,
        0.10,
        "Strict experiment-level partition · random split = false · test untouched",
        transform=ax.transAxes,
        ha="center",
        color=NAVY,
        fontsize=13,
        fontweight="bold",
    )
    ax.axis("off")
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _timeline_asset(out: Path) -> tuple[Path, Path, Path]:
    rows = [
        {
            "order": 1,
            "event": "run_operation",
            "meaning": "typical approximately six hours",
        },
        {"order": 2, "event": "post_run_inspection", "meaning": "images after run"},
        {
            "order": 3,
            "event": "current_state_estimate",
            "meaning": "same-run pseudo-target",
        },
    ]
    source = out.parent.parent / "tables/presentation_six_hour_timeline.csv"
    _write_csv(source, rows)
    fig, ax = plt.subplots(figsize=(11.5, 3.5))
    ax.plot([0.08, 0.92], [0.5, 0.5], color=NAVY, linewidth=3)
    events = [
        (0.12, "Run operation", "typically ≈6 h"),
        (0.52, "Post-run inspection", "gear-tooth image/view"),
        (0.88, "Current-state estimate", "same completed run"),
    ]
    for x, title, body in events:
        ax.scatter([x], [0.5], s=260, color=TEAL, zorder=3)
        ax.text(x, 0.72, title, ha="center", fontsize=14, fontweight="bold", color=NAVY)
        ax.text(x, 0.64, body, ha="center", fontsize=11, color=MUTED)
    ax.text(
        0.5,
        0.19,
        "NOT: six-hour-ahead forecasting · NOT: remaining useful life",
        ha="center",
        fontsize=13,
        fontweight="bold",
        color=TEST_RED,
    )
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    ax.axis("off")
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _architecture_asset(out: Path) -> tuple[Path, Path, Path]:
    stages = [
        ("Image", "1440×2560×3"),
        ("Scale-fill", "640×640"),
        ("Frozen encoder", "80² / 40² / 20²\n× 256 channels"),
        ("Pool + concat", "768-vector"),
        ("Trainable head", "768→128→1"),
        ("Output", "scalar ŷ"),
    ]
    rows = [
        {"order": i + 1, "stage": title, "tensor": body}
        for i, (title, body) in enumerate(stages)
    ]
    source = out.parent.parent / "tables/presentation_tensor_flow.csv"
    _write_csv(source, rows)
    fig, ax = plt.subplots(figsize=(12.5, 3.4))
    for i, (title, body) in enumerate(stages):
        x = 0.015 + i * 0.165
        frozen = title in {"Frozen encoder", "Pool + concat"}
        trainable = title == "Trainable head"
        color = BLUE if frozen else (TEAL if trainable else NAVY)
        face = "#EAF1F6" if frozen else ("#E8F5F3" if trainable else LIGHT)
        ax.add_patch(
            FancyBboxPatch(
                (x, 0.32),
                0.135,
                0.40,
                boxstyle="round,pad=0.012",
                transform=ax.transAxes,
                facecolor=face,
                edgecolor=color,
                linewidth=1.8,
            )
        )
        ax.text(
            x + 0.0675,
            0.61,
            title,
            transform=ax.transAxes,
            ha="center",
            fontsize=11.5,
            fontweight="bold",
            color=color,
        )
        ax.text(
            x + 0.0675,
            0.45,
            body,
            transform=ax.transAxes,
            ha="center",
            fontsize=10.5,
            color=INK,
        )
        if i < len(stages) - 1:
            ax.annotate(
                "",
                xy=(x + 0.16, 0.52),
                xytext=(x + 0.14, 0.52),
                xycoords=ax.transAxes,
                arrowprops={"arrowstyle": "->", "lw": 1.5, "color": NAVY},
            )
    ax.text(
        0.42,
        0.18,
        "32,148,140 parameters frozen",
        transform=ax.transAxes,
        ha="center",
        color=BLUE,
        fontsize=11,
        fontweight="bold",
    )
    ax.text(
        0.75,
        0.18,
        "98,689 parameters trained",
        transform=ax.transAxes,
        ha="center",
        color=TEAL,
        fontsize=11,
        fontweight="bold",
    )
    ax.axis("off")
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _test_scatter_asset(
    predictions: pd.DataFrame, out: Path
) -> tuple[Path, Path, Path]:
    scoped = predictions[predictions["split"].eq("test")].copy()
    source = out.parent.parent / "tables/presentation_exp_f_predictions.csv"
    scoped[
        ["sample_id", "experiment", "run", "tooth_id", "y_true_raw", "y_pred"]
    ].to_csv(source, index=False)
    fig, ax = plt.subplots(figsize=(5.6, 4.6))
    ax.scatter(
        scoped["y_true_raw"],
        scoped["y_pred"],
        s=30,
        color=TEST_COLOR,
        alpha=0.72,
        edgecolor="white",
        linewidth=0.4,
    )
    low = min(scoped["y_true_raw"].min(), scoped["y_pred"].min()) - 0.4
    high = max(scoped["y_true_raw"].max(), scoped["y_pred"].max()) + 0.4
    ax.plot(
        [low, high],
        [low, high],
        linestyle="--",
        color=NAVY,
        linewidth=1.5,
        label="ideal",
    )
    ax.set(
        xlabel="True provisional pseudo-target (%)",
        ylabel="Prediction (%)",
        title="Untouched EXP-F views (N=224)",
    )
    ax.set_xlim(low, high)
    ax.set_ylim(low, high)
    ax.grid(color=GRID)
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _protocol_asset(
    image_manifest: pd.DataFrame, target_dir: Path, out: Path
) -> tuple[Path, Path, Path]:
    tooth = image_manifest["tooth_id"].astype(str)
    b = (
        image_manifest[
            image_manifest["experiment"].eq("EXP-B")
            & image_manifest["run"].eq(1.0)
            & tooth.eq("1")
            & image_manifest["image_type"].eq("camera_sequence")
        ]
        .sort_values("image_id")
        .iloc[0]
    )
    f = (
        image_manifest[
            image_manifest["experiment"].eq("EXP-F")
            & image_manifest["run"].eq(1.0)
            & tooth.eq("1")
            & image_manifest["image_type"].eq("canonical_tooth")
        ]
        .sort_values("image_id")
        .iloc[0]
    )
    rows = []
    fig, axes = plt.subplots(1, 2, figsize=(10, 3.4))
    for ax, row, label, color in (
        (axes[0], b, "EXP-B · camera-sequence close-up", TRAIN_COLOR),
        (axes[1], f, "EXP-F · canonical tooth image", TEST_COLOR),
    ):
        path = target_dir / str(row["overlay_path"])
        with Image.open(path) as image:
            ax.imshow(image.convert("RGB"))
        ax.set_title(label, color=color, fontsize=12, fontweight="bold")
        ax.axis("off")
        rows.append(
            {
                "experiment": row["experiment"],
                "run": int(row["run"]),
                "tooth_id": row["tooth_id"],
                "image_id": row["image_id"],
                "image_type": row["image_type"],
                "archive_path": row["archive_path"],
                "archive_member": row["archive_member"],
                "overlay_path": row["overlay_path"],
                "selection_rule": "experiment/run/tooth/type then lexicographically first image_id",
            }
        )
    fig.suptitle(
        "Deterministic protocol examples — framing is not equivalent",
        color=NAVY,
        fontweight="bold",
    )
    fig.tight_layout()
    source = out.parent.parent / "tables/presentation_protocol_examples.csv"
    _write_csv(source, rows)
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _comparison_asset(
    metrics: pd.DataFrame, naive: pd.DataFrame, out: Path
) -> tuple[Path, Path, Path]:
    model = metrics.query("split == 'test' and evaluation_level == 'image_view'").iloc[
        0
    ]
    naive_test = naive.query("split == 'test' and evaluation_level == 'image_view'")
    rows = [
        {
            "model": "RT-DETR-derived",
            "mae": float(model["mae"]),
            "rmse": float(model["rmse"]),
            "sample_count": int(model["sample_count"]),
        }
    ]
    for row in naive_test.itertuples():
        rows.append(
            {
                "model": row.model_name.replace("_", " "),
                "mae": float(row.mae),
                "rmse": float(row.rmse),
                "sample_count": int(row.sample_count),
            }
        )
    source = out.parent.parent / "tables/presentation_image_level_comparison.csv"
    _write_csv(source, rows)
    frame = pd.DataFrame(rows)
    fig, ax = plt.subplots(figsize=(6.2, 4.2))
    colors = [TEAL, "#91A4B4", "#B8C3CC"]
    bars = ax.bar(frame["model"], frame["mae"], color=colors)
    for bar, value in zip(bars, frame["mae"]):
        ax.text(
            bar.get_x() + bar.get_width() / 2,
            value + 0.025,
            f"{value:.3f}",
            ha="center",
            fontweight="bold",
        )
    ax.set(
        title="Level-matched EXP-F image-view MAE (N=224 each)",
        ylabel="MAE (percentage points)",
    )
    ax.tick_params(axis="x", rotation=15)
    ax.grid(axis="y", color=GRID)
    ax.grid(axis="x", visible=False)
    fig.tight_layout()
    png, svg = _save_pair(fig, out)
    return png, svg, source


def _render_slides(
    slides: list[SlideSpec],
    run_dir: Path,
    assets: dict[str, Path],
    data: dict[str, Any],
) -> list[Path]:
    rendered = run_dir / "rendered_slides"
    rendered.mkdir(exist_ok=True)
    paths: list[Path] = []
    for slide in slides:
        fig = _render_slide(slide, assets, data)
        _footer(
            fig,
            slide,
            data["source_footers"].get(
                slide.number, "Canonical generated evidence; see SLIDE_ASSET_MAP.csv"
            ),
        )
        path = rendered / f"slide_{slide.number:02d}.png"
        fig.savefig(path, dpi=SLIDE_DPI, facecolor=WHITE)
        plt.close(fig)
        paths.append(path)
    return paths


def _render_slide(
    slide: SlideSpec, a: dict[str, Path], d: dict[str, Any]
) -> plt.Figure:
    fig = _figure(slide.title, "Canonical R3 frozen-encoder regression milestone")
    n = slide.number
    if n == 1:
        _add_image(fig, a["target_montage"], (0.055, 0.12, 0.89, 0.43))
        _card(
            fig,
            0.055,
            0.60,
            0.27,
            0.16,
            "1 · Establish evidence",
            "Dataset structure\nand alignment limits",
            color=BLUE,
            align="center",
        )
        _card(
            fig,
            0.365,
            0.60,
            0.27,
            0.16,
            "2 · Define target",
            "Versioned, reviewable\npseudo-label",
            color=TEAL,
            align="center",
        )
        _card(
            fig,
            0.675,
            0.60,
            0.27,
            0.16,
            "3 · Test transfer",
            "Untouched EXP-F\nprotocol",
            color=TEST_RED,
            align="center",
        )
        fig.text(
            0.055,
            0.075,
            "Scope: dataset definition → target → split → RT-DETR-derived scalar regression · PatchTST/fusion not started",
            fontsize=14,
            color=NAVY,
            fontweight="bold",
        )
        _banner(fig)
    elif n == 2:
        _add_image(fig, a["dataset_units"], (0.055, 0.12, 0.89, 0.66))
        fig.text(
            0.50,
            0.082,
            "316 decoded images belong to non-run stages; they are evidence, not model samples.",
            ha="center",
            fontsize=13,
            color=MUTED,
        )
    elif n == 3:
        _add_image(fig, a["timestamp_status"], (0.055, 0.15, 0.43, 0.58))
        _add_image(fig, a["protocol_shift"], (0.515, 0.20, 0.43, 0.48))
        _card(
            fig,
            0.515,
            0.69,
            0.43,
            0.10,
            "Association key",
            "experiment + run + tooth",
            color=TEAL,
            align="center",
            title_size=14,
            body_size=16,
        )
        fig.text(
            0.73,
            0.14,
            "No timestamp coercion · EXP-F is also a protocol/domain shift",
            ha="center",
            fontsize=13,
            color=TEST_RED,
            fontweight="bold",
        )
    elif n == 4:
        _banner(fig)
        _add_image(fig, a["target_montage"], (0.055, 0.39, 0.89, 0.36))
        fig.text(
            0.50,
            0.345,
            r"$d_{e,r,t}=100\times\frac{\mathrm{damage\ candidate\ pixels\ in\ ROI}}{\mathrm{valid\ ROI\ pixels}}$",
            ha="center",
            fontsize=20,
            color=NAVY,
        )
        steps = [
            ("views", "maximum"),
            ("tooth", "one value"),
            ("run", "top-3 mean"),
            ("review", "560 pending"),
        ]
        for i, (title, body) in enumerate(steps):
            _card(
                fig,
                0.06 + i * 0.225,
                0.12,
                0.19,
                0.14,
                title.upper(),
                body,
                color=TEAL if i < 3 else TEST_RED,
                align="center",
                title_size=13,
                body_size=14,
            )
            if i < 3:
                _arrow(fig, (0.25 + i * 0.225, 0.19), (0.275 + i * 0.225, 0.19))
    elif n == 5:
        _add_image(fig, a["timeline"], (0.055, 0.24, 0.89, 0.46))
        _card(
            fig,
            0.07,
            0.12,
            0.25,
            0.12,
            "MODEL INPUT",
            "one post-run image/view",
            color=BLUE,
            align="center",
            title_size=13,
            body_size=14,
        )
        _card(
            fig,
            0.375,
            0.12,
            0.25,
            0.12,
            "MODEL OUTPUT",
            "one provisional scalar",
            color=TEAL,
            align="center",
            title_size=13,
            body_size=14,
        )
        _card(
            fig,
            0.68,
            0.12,
            0.25,
            0.12,
            "ERROR",
            "ŷ − same-view pseudo-target",
            color=TEST_RED,
            align="center",
            title_size=13,
            body_size=14,
        )
    elif n == 6:
        _add_image(fig, a["split"], (0.07, 0.25, 0.86, 0.47))
        _card(
            fig,
            0.12,
            0.12,
            0.76,
            0.11,
            "LEAKAGE GUARDRAIL",
            "Related runs, teeth, views and near-duplicate groups never cross partitions · 0 reported violations",
            color=NAVY,
            align="center",
            title_size=13,
            body_size=13,
        )
    elif n == 7:
        _add_image(fig, a["architecture"], (0.055, 0.23, 0.89, 0.50))
        _card(
            fig,
            0.08,
            0.12,
            0.39,
            0.11,
            "WHY NOT DETECTION?",
            "No authoritative damage boxes/classes → no valid mAP",
            color=TEST_RED,
            align="center",
            title_size=13,
            body_size=13,
        )
        _card(
            fig,
            0.53,
            0.12,
            0.39,
            0.11,
            "FORMULATION",
            "RT-DETR-derived frozen-encoder scalar regression",
            color=TEAL,
            align="center",
            title_size=13,
            body_size=13,
        )
    elif n == 8:
        _add_image(fig, a["training_loss"], (0.055, 0.16, 0.58, 0.60))
        _card(
            fig,
            0.68,
            0.57,
            0.265,
            0.17,
            "TRAINING CONTROL",
            "1 seed · no sweep\nEXP-B train only",
            color=BLUE,
            body_size=14,
        )
        _card(
            fig,
            0.68,
            0.36,
            0.265,
            0.17,
            "VALIDATION",
            "EXP-A · best epoch 1\nearly stop after 6",
            color=VALIDATION_COLOR,
            body_size=14,
        )
        _card(
            fig,
            0.68,
            0.15,
            0.265,
            0.17,
            "TEST",
            "EXP-F untouched\nuntil final evaluation",
            color=TEST_COLOR,
            body_size=14,
        )
        fig.text(
            0.50,
            0.095,
            "Train loss falls while validation remains high: weak transfer / overfitting signal",
            ha="center",
            fontsize=13,
            color=TEST_RED,
            fontweight="bold",
        )
    elif n == 9:
        _banner(fig)
        _add_image(fig, a["test_scatter"], (0.055, 0.14, 0.48, 0.62))
        rows = [
            ("Image/tooth", "224", "0.894", "1.563", "0.361", "−1.176"),
            ("Raw run top-3", "8", "1.347", "1.757", "0.571", "−4.196"),
