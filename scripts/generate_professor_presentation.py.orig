#!/usr/bin/env python3
"""Generate the professor-facing canonical R3 PHM presentation package.

The command reads only hash-pinned generated artifacts. It never opens raw PHM
archives and deliberately excludes the later R4 detector/multitask milestone.
"""

from __future__ import annotations

import argparse
import csv
from dataclasses import dataclass
import json
from pathlib import Path
import sys
import textwrap
